{
  "name": "game-v5-impl-web",
  "version": "0.0.0",
  "private": true,
  "license": "CC-BY-NC-4.0",
  "description": "A browser and terminal implementation of the Game v5 specifications.",
  "type": "module",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "gdr:build": "node scripts/build-gdr.ts",
    "sync:spec": "node scripts/sync-spec.ts",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint .",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:large": "vp test run --mode full",
    "fix": "npm run gdr:build && vp check --fix",
    "check": "npm run gdr:build && vp check && npm run typecheck && npm run test",
    "check:full": "npm run check && npm run test:large && npm run test:browser",
    "cli": "node src/cli/main.ts",
    "web:dev": "vp dev",
    "web:build": "vp build",
    "web:preview": "vp preview",
    "test:browser": "playwright test",
    "screens:capture": "node scripts/capture-screens.ts"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "immer": "11.2.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.159.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  }
}
